# Admin Dashboard Authentication Password
ADMIN_PASSWORD=your_admin_password_here

# GitHub Personal Access Token (for auto-pushing content updates to repo)
GITHUB_TOKEN=your_github_token_here

# Redis Connection URI (e.g. rediss://default:password@xxx.upstash.io:6379)
REDIS_URI=rediss://default:your_password@your_redis_host:6379

# Or Upstash Redis / Vercel KV REST Credentials
KV_REST_API_URL=https://your-upstash-redis-rest-url.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_rest_token_here
